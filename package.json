{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node dev.js",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "preview": "next start -p 3000",
    "clean": "rm -rf .next dist",
    "db:migrate": "node --experimental-strip-types scripts/run-migrations.ts",
    "lint": "tsc --noEmit",
    "test": "node --test tests/unit/*.test.ts tests/integration/*.test.ts tests/e2e/*.test.ts",
    "test:unit": "node --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.ts",
    "test:e2e": "node --test tests/e2e/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "firebase": "^12.18.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.3.3",
    "pg": "^8.23.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
