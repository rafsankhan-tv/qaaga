# ==============================================================================
# QAAGA Super Marketplace — Environment Variables Configuration
# Copy this file to .env and fill in your actual production/development credentials.
# NEVER commit your actual .env file or real secrets to Git.
# ==============================================================================

# 1. CORE SERVER SETTINGS
PORT=3000
NODE_ENV=production
APP_URL=https://qaaga.com

# 2. GEMINI AI API (Required for Cat Assistant & Suchi Vision AI)
# In AI Studio, this is automatically injected via user secrets.
# On VPS/Vercel, obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=

# 3. PRODUCTION POSTGRESQL DATABASE
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://qaaga_user:your_secure_password@localhost:5432/qaaga_db

# Optional direct DB credentials for Docker / Migrations
POSTGRES_USER=qaaga_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=qaaga_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# 4. SECURITY & AUTHENTICATION SECRETS
JWT_SECRET=generate_a_random_64_character_hex_string_for_production
SESSION_SECRET=another_random_string_for_session_encryption
CORS_ORIGIN=https://qaaga.com

# 5. PAYMENT GATEWAYS (Bangladesh & International)
# bKash Merchant API (v1.2.0-M)
BKASH_APP_KEY=
BKASH_SECRET_KEY=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=false

# Nagad PGW
NAGAD_MERCHANT_ID=
NAGAD_PUBLIC_KEY=
NAGAD_PRIVATE_KEY=

# SSLCommerz Payment Gateway
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWD=
SSLCOMMERZ_IS_SANDBOX=false

# Stripe (Optional International Card Gateway)
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
STRIPE_WEBHOOK_SECRET=

# 6. CLOUD STORAGE (AWS S3 / Cloudflare R2 for Image Uploads & eBook Storage)
S3_BUCKET_NAME=qaaga-uploads
S3_REGION=ap-southeast-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# 7. SMS GATEWAY & NOTIFICATIONS (Bangladesh SMS)
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=QAAGA
